---
layout: null
---
{% assign recipes = site.pages | where: "layout", "recipe" | sort: "title" -%}
[
{%- for r in recipes %}
  {
    "title": {{ r.title | jsonify }},
    "url": {{ r.url | relative_url | jsonify }},
    "tags": {{ r.tags | default: empty | jsonify }},
    "image": {% if r.image %}{{ r.image | prepend: r.url | relative_url | jsonify }}{% else %}null{% endif %},
    "cooked": {{ r.cooked | default: empty | jsonify }},
    "rating": {{ r.rating | default: 0 }},
    "text": {{ r.content | strip_html | normalize_whitespace | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{%- endfor %}
]
